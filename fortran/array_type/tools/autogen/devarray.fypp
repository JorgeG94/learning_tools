!! Ledger-tracked, device-aware array types. GENERATED by fypp from
!! tools/autogen/devarray.fypp -- edit the template, then run autogen.sh.
#! ---------------------------------------------------------------------------
#! The kind x rank product lives here and only here. Adding a kind or a rank
#! is one entry in these two tables. Types are named <kind>_<rank>d_t.
#! ---------------------------------------------------------------------------
#:set KINDS = [('dp', 'real(dp)', 'MEM_KIND_R64'), ('i32', 'integer(int32)', 'MEM_KIND_I32')]
#:set RANKS = {'dp': [1, 2, 3], 'i32': [1, 2, 3]}
#:set shp = lambda r: ', '.join([':'] * r)
#:set bounds = lambda r: ', '.join(['lo(%d):ub(%d)' % (i, i) for i in range(1, r + 1)])
module devarray
   !! One type per (kind, rank): dp_1d_t .. dp_3d_t for real(dp),
   !! i32_1d_t .. i32_3d_t for integer(int32).
   !!
   !! Lifecycle:  create -> to_device | alloc_device -> [update_*, fill]* -> destroy
   !!
   !!   call x%create("baro%eta", tag, ub=[nx+1, ny+1], lb=[0, 0])
   !!   call y%create_like("baro%eta_old", tag, x)       ! same bounds as x
   !!   call x%to_device()          ! map and upload the host contents
   !!   call y%alloc_device()       ! map only (contents undefined, or `fill`)
   !!   call kernel(x%data, ...)    ! kernels take plain arrays
   !!   call x%destroy()
   !!
   !! * `data` is public. Kernels take `x%data` as a plain array argument and
   !!   never see the wrapper, so hot loops are unchanged.
   !! * Every create/map/destroy updates `mem_ledger`, so per-owner memory
   !!   totals come for free instead of hand-summed `bytes()` routines.
   !! * Never change the allocation of `data` yourself. That includes
   !!   realloc-on-assignment: `x%data = other` with a different shape
   !!   silently reallocates. Write `x%data(:,:) = other`. Every method, and
   !!   every collective operation, checks for this and stops with the name.
   !! * A finalizer calls `destroy` as a safety net, but keep calling
   !!   `destroy`: main-program and module variables are never finalized,
   !!   and some compilers miss cases (experiments/finalizers/FINDINGS.md).
   !!   `mem_check_leaks` at shutdown names anything left over.
   !! * Assignment between these objects (scalars or arrays) is a fatal
   !!   error: a copy would share the ledger entry and the device mapping.
   !! * A tracked object must stay where it was created (the ledger keeps its
   !!   address): don't move it with intrinsic assignment of a parent type.
   !! * Without OpenACC, the device methods act on the host copy and device
   !!   bytes stay zero, so the same code builds and runs on a CPU.
   use, intrinsic :: iso_fortran_env, only: real64, int32, int64
   use, intrinsic :: iso_c_binding, only: c_ptr, c_loc, c_null_ptr, c_associated, c_f_pointer
   use mem_ledger, only: mem_tag_t
   use mem_ledger_backend, only: mem_track, mem_untrack, mem_track_device, mem_untrack_device, &
                                 mem_is_live, mem_object_name, mem_fatal, MEM_KIND_R64, MEM_KIND_I32
   use mem_device, only: mem_require_device
   implicit none
   private

   integer, parameter :: dp = real64

   integer, parameter :: ST_EMPTY = 0, ST_HOST = 1, ST_HOST_DEVICE = 2

#:for k, ftype, kcode in KINDS
#:for r in RANKS[k]
#:set T = '%s_%dd_t' % (k, r)
   type, public :: ${T}$
      !! `${ftype}$` rank-${r}$ array tracked by `mem_ledger`.
      ${ftype}$, allocatable :: data(${shp(r)}$)
      integer(int64), private :: id = 0
      integer, private :: state = ST_EMPTY
      type(c_ptr), private :: addr = c_null_ptr     !! where `data` was allocated
      integer(int64), private :: n = 0              !! and how many elements
      logical, private :: has_fill = .false.
      ${ftype}$, private :: fill_value = 0
   contains
      procedure :: create => ${T}$_create
      procedure, private :: like_obj => ${T}$_create_like_obj
      procedure, private :: like_arr => ${T}$_create_like_arr
      generic :: create_like => like_obj, like_arr
      procedure :: create_from => ${T}$_create_from
      procedure :: to_device => ${T}$_to_device
      procedure :: alloc_device => ${T}$_alloc_device
      procedure :: update_device => ${T}$_update_device
      procedure :: update_host => ${T}$_update_host
      procedure :: fill => ${T}$_fill
      procedure :: assert_bounds => ${T}$_assert_bounds
      procedure :: destroy => ${T}$_destroy
      procedure :: bytes => ${T}$_bytes
      procedure :: is_created => ${T}$_is_created
      procedure :: is_on_device => ${T}$_is_on_device
      procedure, private :: check_intact => ${T}$_check_intact
      procedure, private :: assign => ${T}$_assign
      generic :: assignment(=) => assign
#ifndef DEVARRAY_NO_FINAL
      final :: ${T}$_final, ${T}$_final_r1, ${T}$_final_r2
#endif
   end type ${T}$

#:endfor
#:endfor
contains

#:for k, ftype, kcode in KINDS
#:for r in RANKS[k]
#:set T = '%s_%dd_t' % (k, r)
   ! ======================================================== ${T}$

   subroutine ${T}$_create(this, name, tag, ub, lb, fill)
      !! Allocate `data(lb(1):ub(1), ...)` on the host and register it under
      !! `tag`. `lb` defaults to 1; pass it by keyword. With `fill`, the
      !! array starts at that value, on the device too once mapped.
      class(${T}$), intent(inout), target :: this
      character(len=*), intent(in) :: name
      type(mem_tag_t), intent(in) :: tag
      integer, intent(in) :: ub(${r}$)
      integer, intent(in), optional :: lb(${r}$)
      ${ftype}$, intent(in), optional :: fill
      integer :: lo(${r}$), ierr

      if (this%state /= ST_EMPTY) &
         call mem_fatal("create: '"//name//"' already created (as '"// &
                        mem_object_name(this%id)//"'); destroy it first")
      lo = 1
      if (present(lb)) lo = lb
      if (any(ub < lo - 1)) call mem_fatal("create: '"//name//"' has ub < lb - 1")

      allocate (this%data(${bounds(r)}$), stat=ierr)
      if (ierr /= 0) call mem_fatal("create: host allocation failed for '"//name//"'")
      this%n = size(this%data, kind=int64)
      this%addr = c_null_ptr
      if (this%n > 0) this%addr = c_loc(this%data)
      this%has_fill = present(fill)
      if (present(fill)) then
         this%fill_value = fill
         this%data = fill
      end if

      this%id = mem_track(name, tag, this%bytes(), kind_code=${kcode}$, addr=this%addr, &
                          nelem=this%n, owner=${T}$_owner(this), validate=${T}$_validate)
      this%state = ST_HOST
   end subroutine ${T}$_create

   subroutine ${T}$_create_like_obj(this, name, tag, mold, fill)
      !! Create with the same bounds as another ${T}$.
      class(${T}$), intent(inout), target :: this
      character(len=*), intent(in) :: name
      type(mem_tag_t), intent(in) :: tag
      class(${T}$), intent(in), target :: mold
      ${ftype}$, intent(in), optional :: fill
      if (mold%state == ST_EMPTY) call mem_fatal("create_like: mold for '"//name//"' is not created")
      call mold%check_intact("create_like")
      call this%create(name, tag, ubound(mold%data), lbound(mold%data), fill)
   end subroutine ${T}$_create_like_obj

   subroutine ${T}$_create_like_arr(this, name, tag, mold, fill)
      !! Create with the same bounds as an allocatable array (bounds of an
      !! allocatable dummy are preserved, unlike an assumed-shape one).
      class(${T}$), intent(inout), target :: this
      character(len=*), intent(in) :: name
      type(mem_tag_t), intent(in) :: tag
      ${ftype}$, allocatable, intent(in) :: mold(${shp(r)}$)
      ${ftype}$, intent(in), optional :: fill
      if (.not. allocated(mold)) call mem_fatal("create_like: mold for '"//name//"' is not allocated")
      call this%create(name, tag, ubound(mold), lbound(mold), fill)
   end subroutine ${T}$_create_like_arr

   subroutine ${T}$_create_from(this, name, tag, source)
      !! Create with the bounds and the values of an allocatable array.
      class(${T}$), intent(inout), target :: this
      character(len=*), intent(in) :: name
      type(mem_tag_t), intent(in) :: tag
      ${ftype}$, allocatable, intent(in) :: source(${shp(r)}$)
      if (.not. allocated(source)) call mem_fatal("create_from: source for '"//name//"' is not allocated")
      call this%create(name, tag, ubound(source), lbound(source))
      this%data(${shp(r)}$) = source
   end subroutine ${T}$_create_from

   subroutine ${T}$_to_device(this)
      !! Map to the device and upload the host contents.
      class(${T}$), intent(inout), target :: this
      call this%check_intact("to_device")
      call ${T}$_check_mappable(this, "to_device")
      !$acc enter data copyin(this%data)
#ifdef _OPENACC
      call mem_track_device(this%id, this%bytes())
#endif
      this%state = ST_HOST_DEVICE
   end subroutine ${T}$_to_device

   subroutine ${T}$_alloc_device(this)
      !! Map to the device without uploading. The device contents are
      !! undefined, unless `create` was given `fill`: then they hold it.
      class(${T}$), intent(inout), target :: this
      call this%check_intact("alloc_device")
      call ${T}$_check_mappable(this, "alloc_device")
      !$acc enter data create(this%data)
#ifdef _OPENACC
      call mem_track_device(this%id, this%bytes())
#endif
      this%state = ST_HOST_DEVICE
      if (this%has_fill) call ${k}$_fill_kernel(this%data, this%n, this%fill_value, .true.)
   end subroutine ${T}$_alloc_device

   subroutine ${T}$_check_mappable(this, where)
      class(${T}$), intent(in) :: this
      character(len=*), intent(in) :: where
      if (this%state == ST_EMPTY) call mem_fatal(where//": array not created")
      if (this%state == ST_HOST_DEVICE) &
         call mem_fatal(where//": '"//mem_object_name(this%id)//"' is already on the device")
      call mem_require_device(this%bytes(), "'"//mem_object_name(this%id)//"'")
   end subroutine ${T}$_check_mappable

   subroutine ${T}$_update_device(this)
      class(${T}$), intent(inout), target :: this
      call this%check_intact("update_device")
      if (this%state /= ST_HOST_DEVICE) call mem_fatal("update_device: '"//mem_object_name(this%id)// &
                                                        "' is not on the device")
      !$acc update device(this%data)
   end subroutine ${T}$_update_device

   subroutine ${T}$_update_host(this)
      class(${T}$), intent(inout), target :: this
      call this%check_intact("update_host")
      if (this%state /= ST_HOST_DEVICE) call mem_fatal("update_host: '"//mem_object_name(this%id)// &
                                                      "' is not on the device")
      !$acc update self(this%data)
   end subroutine ${T}$_update_host

   subroutine ${T}$_fill(this, value)
      !! Set every element to `value` where the data currently lives: on the
      !! device if mapped (the host copy is left alone), else on the host.
      class(${T}$), intent(inout), target :: this
      ${ftype}$, intent(in) :: value
      call this%check_intact("fill")
      if (this%state == ST_EMPTY) call mem_fatal("fill: array not created")
      call ${k}$_fill_kernel(this%data, this%n, value, this%state == ST_HOST_DEVICE)
   end subroutine ${T}$_fill

   subroutine ${T}$_assert_bounds(this, ub, lb)
      !! Fatal unless `data` has exactly these bounds (`lb` defaults to 1).
      !! Call once at init with the bounds your kernels declare: an
      !! explicit-shape dummy silently reinterprets mismatched bounds.
      class(${T}$), intent(in), target :: this
      integer, intent(in) :: ub(${r}$)
      integer, intent(in), optional :: lb(${r}$)
      integer :: lo(${r}$)
      call this%check_intact("assert_bounds")
      if (this%state == ST_EMPTY) call mem_fatal("assert_bounds: array not created")
      lo = 1
      if (present(lb)) lo = lb
      if (any(lbound(this%data) /= lo) .or. any(ubound(this%data) /= ub)) &
         call mem_fatal("assert_bounds: '"//mem_object_name(this%id)//"' has bounds "// &
                        bounds_str(lbound(this%data), ubound(this%data))//", expected "// &
                        bounds_str(lo, ub))
   end subroutine ${T}$_assert_bounds

   subroutine ${T}$_destroy(this)
      !! Unmap, deallocate and retire from the ledger. A no-op on an array
      !! that was never created, so teardown can call it unconditionally.
      class(${T}$), intent(inout), target :: this

      if (this%state == ST_EMPTY) return
      if (.not. mem_is_live(this%id)) &
         call mem_fatal("destroy: '"//mem_object_name(this%id)//"' is already dead in the ledger."// &
                        " Was this object copied with intrinsic assignment?")
      call this%check_intact("destroy")
      if (this%state == ST_HOST_DEVICE) then
         !$acc exit data delete(this%data)
#ifdef _OPENACC
         call mem_untrack_device(this%id)
#endif
      end if
      call mem_untrack(this%id)
      deallocate (this%data)
      this%id = 0
      this%state = ST_EMPTY
      this%addr = c_null_ptr
      this%n = 0
      this%has_fill = .false.
   end subroutine ${T}$_destroy

   pure integer(int64) function ${T}$_bytes(this) result(b)
      !! Bytes as registered in the ledger.
      class(${T}$), intent(in) :: this
      b = (storage_size(this%fill_value, kind=int64)/8)*this%n
   end function ${T}$_bytes

   pure logical function ${T}$_is_created(this)
      class(${T}$), intent(in) :: this
      ${T}$_is_created = this%state /= ST_EMPTY
   end function ${T}$_is_created

   pure logical function ${T}$_is_on_device(this)
      class(${T}$), intent(in) :: this
      ${T}$_is_on_device = this%state == ST_HOST_DEVICE
   end function ${T}$_is_on_device

   subroutine ${T}$_check_intact(this, where)
      class(${T}$), intent(in), target :: this
      character(len=*), intent(in) :: where
      if (this%state == ST_EMPTY) return
      if (.not. ${T}$_intact(this)) &
         call mem_fatal(where//": '"//mem_object_name(this%id)//"' was reallocated or deallocated"// &
                        " behind devarray (realloc-on-assignment? write x%data(${shp(r)}$) = ..."// &
                        " instead of x%data = ...)")
   end subroutine ${T}$_check_intact

   logical function ${T}$_intact(x) result(ok)
      type(${T}$), intent(in), target :: x
      ok = allocated(x%data)
      if (ok) ok = size(x%data, kind=int64) == x%n
      if (ok .and. x%n > 0) ok = c_associated(c_loc(x%data), x%addr)
   end function ${T}$_intact

   function ${T}$_owner(x) result(p)
      !! Address of the object itself, for the ledger's validator.
      type(${T}$), intent(in), target :: x
      type(c_ptr) :: p
      p = c_loc(x)
   end function ${T}$_owner

   logical function ${T}$_validate(owner)
      !! Ledger callback: is the object at `owner` still as registered?
      type(c_ptr), value :: owner
      type(${T}$), pointer :: p
      call c_f_pointer(owner, p)
      ${T}$_validate = ${T}$_intact(p)
   end function ${T}$_validate

   impure elemental subroutine ${T}$_assign(lhs, rhs)
      !! Copying is forbidden, for scalars and arrays of ${T}$ alike: a copy
      !! would share the ledger entry and the device mapping. Copy `data`
      !! explicitly if that is what you want.
      !! Empty-to-empty is allowed: nothing is shared, and it keeps compiler
      !! quirks around default initialization harmless.
      class(${T}$), intent(inout) :: lhs
      class(${T}$), intent(in) :: rhs
      if (rhs%state /= ST_EMPTY) &
         call mem_fatal("assignment of ${T}$ is not allowed (copying '"// &
                        mem_object_name(rhs%id)//"'); copy %data explicitly instead")
      if (lhs%state /= ST_EMPTY) &
         call mem_fatal("assignment of ${T}$ is not allowed (it would overwrite '"// &
                        mem_object_name(lhs%id)//"'); destroy it first")
   end subroutine ${T}$_assign

#ifndef DEVARRAY_NO_FINAL
   ! Finalizers for scalars and rank-1/rank-2 arrays of ${T}$. Not one
   ! impure elemental final: nvfortran 26.5's runtime then calls the
   ! (elemental) assignment procedure instead of the final procedure.
   subroutine ${T}$_final(this)
      !! Safety net, not the primary API (see module notes).
      type(${T}$), intent(inout) :: this
      call this%destroy()
   end subroutine ${T}$_final

   subroutine ${T}$_final_r1(this)
      type(${T}$), intent(inout) :: this(:)
      integer :: i
      do i = 1, size(this)
         call this(i)%destroy()
      end do
   end subroutine ${T}$_final_r1

   subroutine ${T}$_final_r2(this)
      type(${T}$), intent(inout) :: this(:, :)
      integer :: i, j
      do j = 1, size(this, 2)
         do i = 1, size(this, 1)
            call this(i, j)%destroy()
         end do
      end do
   end subroutine ${T}$_final_r2
#endif

#:endfor
   subroutine ${k}$_fill_kernel(a, n, v, on_dev)
      integer(int64), intent(in) :: n
      ${ftype}$, intent(inout) :: a(n)
      ${ftype}$, intent(in) :: v
      logical, intent(in) :: on_dev
      integer(int64) :: i
#ifndef _OPENACC
      if (on_dev) continue    ! without OpenACC there is only the host copy
#endif
      !$acc parallel loop present(a) if(on_dev)
      do i = 1, n
         a(i) = v
      end do
   end subroutine ${k}$_fill_kernel

#:endfor
   function bounds_str(lo, hi) result(s)
      integer, intent(in) :: lo(:), hi(:)
      character(len=:), allocatable :: s
      character(len=32) :: b
      integer :: i
      s = '('
      do i = 1, size(lo)
         write (b, '(i0, ":", i0)') lo(i), hi(i)
         s = s//trim(b)
         if (i < size(lo)) s = s//', '
      end do
      s = s//')'
   end function bounds_str

end module devarray
