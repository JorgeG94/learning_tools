!! Ledger-tracked, device-aware array types. GENERATED by fypp from
!! tools/autogen/devarray.fypp -- edit the template, then run autogen.sh.
#! ---------------------------------------------------------------------------
#! The kind x rank product lives here and only here. Adding sp, int32, int64 or
#! another rank is one entry in these two tables.
#! ---------------------------------------------------------------------------
#:set KINDS = [('dp', 'real(dp)')]
#:set RANKS = {'dp': [1, 2, 3]}
#:set shp = lambda r: ', '.join([':'] * r)
#:set bounds = lambda r: ', '.join(['lo(%d):ub(%d)' % (i, i) for i in range(1, r + 1)])
module devarray
   !! One type per (kind, rank), e.g. `dp2_t` for `real(dp)` rank 2.
   !!
   !! Lifecycle:  create -> [to_device -> update_*]* -> destroy
   !!
   !! * `data` is public. Kernels take `x%data` as a plain array argument and
   !!   never see the wrapper, so hot loops are unchanged.
   !! * Every create/to_device/destroy updates `mem_ledger`, so per-owner
   !!   memory totals come for free instead of hand-summed `bytes()` routines.
   !! * No finalizers: call `destroy` explicitly; `mem_check_leaks` at
   !!   shutdown names anything you forgot.
   !! * Do not copy these objects with `=`. The copy shares the ledger id,
   !!   and the second destroy is reported as a fatal error.
   !! * Without OpenACC, `to_device`/`update_*` are no-ops and device bytes
   !!   stay zero, so the same code builds and runs on a CPU.
   use, intrinsic :: iso_fortran_env, only: real64, int64
   use mem_ledger, only: mem_track, mem_untrack, mem_track_device, mem_untrack_device, &
                         mem_is_live, mem_object_name, mem_fatal, MEM_UNTAGGED
   implicit none
   private

   integer, parameter :: dp = real64

   integer, parameter :: ST_EMPTY = 0, ST_HOST = 1, ST_HOST_DEVICE = 2

#:for k, ftype in KINDS
#:for r in RANKS[k]
   type, public :: ${k}$${r}$_t
      !! `${ftype}$` rank-${r}$ array tracked by `mem_ledger`.
      ${ftype}$, allocatable :: data(${shp(r)}$)
      integer(int64), private :: id = 0
      integer, private :: state = ST_EMPTY
   contains
      procedure :: create => ${k}$${r}$_create
      procedure :: to_device => ${k}$${r}$_to_device
      procedure :: update_device => ${k}$${r}$_update_device
      procedure :: update_host => ${k}$${r}$_update_host
      procedure :: destroy => ${k}$${r}$_destroy
      procedure :: bytes => ${k}$${r}$_bytes
      procedure :: is_created => ${k}$${r}$_is_created
      procedure :: is_on_device => ${k}$${r}$_is_on_device
      procedure :: ledger_id => ${k}$${r}$_ledger_id
   end type ${k}$${r}$_t

#:endfor
#:endfor
contains

#:for k, ftype in KINDS
#:for r in RANKS[k]
   ! ======================================================== ${k}$${r}$_t

   subroutine ${k}$${r}$_create(this, name, ub, tag, lb, fill)
      !! Allocate `data(lb(1):ub(1), ...)` on the host and register it.
      !! `lb` defaults to 1. `tag` comes from `mem_register_tag`.
      class(${k}$${r}$_t), intent(inout) :: this
      character(len=*), intent(in) :: name
      integer, intent(in) :: ub(${r}$)
      integer, intent(in), optional :: tag
      integer, intent(in), optional :: lb(${r}$)
      ${ftype}$, intent(in), optional :: fill
      integer :: lo(${r}$), t, ierr

      if (this%state /= ST_EMPTY) &
         call mem_fatal("create: '"//name//"' already created (as '"// &
                        mem_object_name(this%id)//"'); destroy it first")
      lo = 1
      if (present(lb)) lo = lb
      if (any(ub < lo - 1)) call mem_fatal("create: '"//name//"' has ub < lb - 1")
      t = MEM_UNTAGGED
      if (present(tag)) t = tag

      allocate (this%data(${bounds(r)}$), stat=ierr)
      if (ierr /= 0) call mem_fatal("create: host allocation failed for '"//name//"'")
      if (present(fill)) this%data = fill

      this%id = mem_track(name, t, this%bytes())
      this%state = ST_HOST
   end subroutine ${k}$${r}$_create

   subroutine ${k}$${r}$_to_device(this, copyin)
      !! Map to the device. `copyin=.true.` (default) uploads the host
      !! contents; `.false.` only allocates (scratch workspaces).
      class(${k}$${r}$_t), intent(inout) :: this
      logical, intent(in), optional :: copyin
      logical :: do_copy

      if (this%state == ST_EMPTY) call mem_fatal("to_device: array not created")
      if (this%state == ST_HOST_DEVICE) &
         call mem_fatal("to_device: '"//mem_object_name(this%id)//"' already on device")
      do_copy = .true.
      if (present(copyin)) do_copy = copyin

      if (do_copy) then
         !$acc enter data copyin(this%data)
      else
         !$acc enter data create(this%data)
      end if
#ifdef _OPENACC
      call mem_track_device(this%id, this%bytes())
#endif
      this%state = ST_HOST_DEVICE
   end subroutine ${k}$${r}$_to_device

   subroutine ${k}$${r}$_update_device(this)
      class(${k}$${r}$_t), intent(inout) :: this
      if (this%state /= ST_HOST_DEVICE) call mem_fatal("update_device: array not on device")
      !$acc update device(this%data)
   end subroutine ${k}$${r}$_update_device

   subroutine ${k}$${r}$_update_host(this)
      class(${k}$${r}$_t), intent(inout) :: this
      if (this%state /= ST_HOST_DEVICE) call mem_fatal("update_host: array not on device")
      !$acc update self(this%data)
   end subroutine ${k}$${r}$_update_host

   subroutine ${k}$${r}$_destroy(this)
      !! Unmap, deallocate and retire from the ledger. A no-op on an array
      !! that was never created, so teardown can call it unconditionally.
      class(${k}$${r}$_t), intent(inout) :: this

      if (this%state == ST_EMPTY) return
      if (.not. mem_is_live(this%id)) &
         call mem_fatal("destroy: '"//mem_object_name(this%id)//"' is already dead in the ledger."// &
                        " Was this object copied with intrinsic assignment (a = b)?")

      if (this%state == ST_HOST_DEVICE) then
         !$acc exit data delete(this%data)
#ifdef _OPENACC
         call mem_untrack_device(this%id)
#endif
      end if
      call mem_untrack(this%id)
      deallocate (this%data)
      this%id = 0
      this%state = ST_EMPTY
   end subroutine ${k}$${r}$_destroy

   pure integer(int64) function ${k}$${r}$_bytes(this) result(b)
      class(${k}$${r}$_t), intent(in) :: this
      b = 0
      if (allocated(this%data)) b = (storage_size(this%data, kind=int64)/8)*size(this%data, kind=int64)
   end function ${k}$${r}$_bytes

   pure logical function ${k}$${r}$_is_created(this)
      class(${k}$${r}$_t), intent(in) :: this
      ${k}$${r}$_is_created = this%state /= ST_EMPTY
   end function ${k}$${r}$_is_created

   pure logical function ${k}$${r}$_is_on_device(this)
      class(${k}$${r}$_t), intent(in) :: this
      ${k}$${r}$_is_on_device = this%state == ST_HOST_DEVICE
   end function ${k}$${r}$_is_on_device

   pure integer(int64) function ${k}$${r}$_ledger_id(this)
      class(${k}$${r}$_t), intent(in) :: this
      ${k}$${r}$_ledger_id = this%id
   end function ${k}$${r}$_ledger_id

#:endfor
#:endfor
end module devarray
